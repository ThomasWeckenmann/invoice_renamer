{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoice Renamer",
  "version": "0.1.0",
  "identifier": "app.invoicerenamer.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd app && npm run dev",
    "beforeBuildCommand": "cd app && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Invoice Renamer",
        "width": 960,
        "height": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/invoice-renamer-worker"]
  }
}
